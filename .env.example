SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string — ใช้รัน migration ใน supabase/migrations/ (ต้องการ psycopg)
# Supabase Dashboard → Project Settings → Database → Connection string → URI
# เปลี่ยน [YOUR-PASSWORD] เป็นรหัสผ่านของโปรเจกต์
DATABASE_URL=

# ---------- บริการ AI สำหรับ "AI ที่ปรึกษา" (แท็บในหน้า /community) ----------
# ใส่ key ของเจ้าใดเจ้าหนึ่งก็ได้ ระบบจะเลือกใช้อัตโนมัติ
# (เรียงตามลำดับ: BUILT_IN_FORGE → Anthropic → OpenAI → Gemini)

# Provided by Manus WebDev runtime when AI is enabled:
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=

# Anthropic (Claude) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI (GPT) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Make.com webhook (POST /api/tcas/*) — ตั้งเป็นสตริงสุ่มยาว ๆ แล้วใส่ค่าเดียวกันใน header X-Webhook-Secret ของ Make
MAKE_WEBHOOK_SECRET=

# อีเมลที่ได้สิทธิ์แอดมิน (คั่นด้วย , หรือ ;) — ใช้ตอบ Ticket และปิดตั๋วได้
# อีกทางคือตั้ง users.is_admin = true ใน Supabase
ADMIN_EMAILS=

# ---------- Web Push notifications (optional, HTTPS required except localhost) ----------
# Generate a VAPID key pair once with: npx web-push generate-vapid-keys
# Keep the private key secret. VAPID_PUBLIC_KEY is exposed to the browser.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
